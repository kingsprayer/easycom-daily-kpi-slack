# EasyEcom API Credentials
# Obtained from EasyEcom Dashboard: Account Settings > Change Credentials
EASYECOM_API_KEY=your_x_api_key_here
EASYECOM_JWT_TOKEN=your_jwt_bearer_token_here
EASYECOM_BASE_URL=https://api.easyecom.io

# Slack Integration Webhook
# Created from Slack API: https://api.slack.com/apps > Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR_WORKSPACE_ID/YOUR_CHANNEL_ID/YOUR_WEBHOOK_TOKEN

# Optional: Run in mock mode if no credentials provided
# Set to 'true' or 'false'
USE_MOCK_DATA=false
